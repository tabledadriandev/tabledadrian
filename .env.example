# Server only. Never prefix secrets with NEXT_PUBLIC_.

# Preferred: Resend (https://resend.com). Sends enquiries to CONTACT_TO_EMAIL.
RESEND_API_KEY=
CONTACT_TO_EMAIL=adrian@tabledadrian.com
# After you verify tabledadrian.com in Resend, set this to that from-address.
# CONTACT_FROM_EMAIL=Table d'Adrian <hello@tabledadrian.com>

# Optional fallback: Zapier, Make, or another mailbox webhook.
CONTACT_WEBHOOK_URL=

# Supabase anon keys are public by design. Service role keys must stay on the server.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
