ww.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down sm:w-6 sm:h-6 text-foreground-muted\"><path d=\"m6 9 6 6 6-6\"></path></svg></div></section><section id=\"about\" class=\"py-16 sm:py-20 md:py-24 lg:py-32 relative bg-white\"><div class=\"container mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12 lg:gap-16 items-center max-w-6xl mx-auto\"><div class=\"relative order-2 lg:order-1\" style=\"opacity:0;transform:translateX(-100px)\"><div class=\"aspect-[4/5] bg-foreground/5 rounded-xl overflow-hidden shadow-lg relative\"><img alt=\"Chef Adrian\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, 50vw\" srcSet=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D800%26q%3D80&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D800%26q%3D80&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D800%26q%3D80&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D800%26q%3D80&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D800%26q%3D80&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D800%26q%3D80&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D800%26q%3D80&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D800%26q%3D80&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D800%26q%3D80&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556910103-1c02745aae4d%3Fw%3D800%26q%3D80&amp;w=3840&amp;q=75\"/></div></div><div class=\"space-y-4 sm:space-y-6 order-1 lg:order-2\" style=\"opacity:0\"><h2 class=\"text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold text-foreground\" style=\"opacity:0;transform:translateY(60px)\">About Chef Adrian</h2><p class=\"text-base sm:text-lg text-foreground-muted leading-relaxed\" style=\"opacity:0;transform:translateY(60px)\">Chef Adrian brings 15+ years of culinary mastery to your table. Trained at the prestigious EHL Swiss Hotel Management School and certified in health and nutrition from Stanford, Chef Adrian combines Michelin-star techniques with personalized wellness.</p><p class=\"text-base sm:text-lg text-foreground-muted leading-relaxed\" style=\"opacity:0;transform:translateY(60px)\">From intimate dinner parties to grand celebrations, every dish is crafted with precision, passion, and an unwavering commitment to excellence. Experience the art of fine dining reimagined for your home.</p><div class=\"flex items-center space-x-2 text-primary group cursor-pointer pt-2\" style=\"opacity:0;transform:translateY(60px)\"><a class=\"font-medium flex items-center space-x-2 group-hover:space-x-3 transition-all text-sm sm:text-base\" href=\"/about\"><span>Learn More</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right group-hover:translate-x-1 transition-transform\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></div></section><section id=\"services\" class=\"py-16 sm:py-20 md:py-24 lg:py-32 bg-white\"><div class=\"container mx-auto px-4 s