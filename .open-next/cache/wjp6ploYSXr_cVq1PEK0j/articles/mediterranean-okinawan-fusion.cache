{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/articles/layout,_N_T_/articles/[slug]/layout,_N_T_/articles/[slug]/page,_N_T_/articles/mediterranean-okinawan-fusion"}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"scroll-smooth __variable_25556b __variable_f367f3\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/cccb76cee38030ea-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/e4af272ccee01ff0-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1540189549336-e6e99c3679fe%3Fw%3D1200%26q%3D80&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1540189549336-e6e99c3679fe%3Fw%3D1200%26q%3D80&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1540189549336-e6e99c3679fe%3Fw%3D1200%26q%3D80&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1540189549336-e6e99c3679fe%3Fw%3D1200%26q%3D80&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1540189549336-e6e99c3679fe%3Fw%3D1200%26q%3D80&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1540189549336-e6e99c3679fe%3Fw%3D1200%26q%3D80&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1540189549336-e6e99c3679fe%3Fw%3D1200%26q%3D80&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1540189549336-e6e99c3679fe%3Fw%3D1200%26q%3D80&amp;w=3840&amp;q=75 3840w\" imageSizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 896px\" fetchPriority=\"high\"/><link rel=\"stylesheet\" href=\"/_next/static/css/5f262fa293564bf3.c