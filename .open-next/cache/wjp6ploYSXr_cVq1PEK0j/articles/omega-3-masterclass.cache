{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/articles/layout,_N_T_/articles/[slug]/layout,_N_T_/articles/[slug]/page,_N_T_/articles/omega-3-masterclass"}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"scroll-smooth __variable_25556b __variable_f367f3\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/cccb76cee38030ea-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/e4af272ccee01ff0-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1519708227418-c8fd9a32b7a2%3Fw%3D1200%26q%3D80&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1519708227418-c8fd9a32b7a2%3Fw%3D1200%26q%3D80&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1519708227418-c8fd9a32b7a2%3Fw%3D1200%26q%3D80&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1519708227418-c8fd9a32b7a2%3Fw%3D1200%26q%3D80&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1519708227418-c8fd9a32b7a2%3Fw%3D1200%26q%3D80&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1519708227418-c8fd9a32b7a2%3Fw%3D1200%26q%3D80&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1519708227418-c8fd9a32b7a2%3Fw%3D1200%26q%3D80&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1519708227418-c8fd9a32b7a2%3Fw%3D1200%26q%3D80&amp;w=3840&amp;q=75 3840w\" imageSizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 896px\" fetchPriority=\"high\"/><link rel=\"stylesheet\" href=\"/_next/static/css/5f262fa293564bf3.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-f5cf60662512cb8e.js\"/><script src=\"/_next/static/chunks/fd9d1056-23d269fad292388a.js\" async=\"\"></script><script src=\"/_next/static/chunks/117-dff09e228c6f085f.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-eeeeadff66dce7cb.js\" async=\"\"></script><script src=\"/_next/static/chunks/230-cdbb7de8ba0e9730.js\" async=\"\"></script><script src=\"/_next/static/chunks/137-5b138169312cc622.js\" async=\"\"></script><script src=\"/_next/static/chunks/145-75c359b60857aeb9.js\" async=\"\"></script><script src=\"/_next/static/chunks/368-1ea72f002b8b709f.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/articles/%5Bslug%5D/page-49b755f762575e4d.js\" async=\"\"></script><script src=\"/_next/static/chunks/648-c9f1e7714301de28.js\" async=\"\"></script><script src=\"/_next/static/chunks/141-0dbb7c5180bdee84.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-33e05870e39ca1ce.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/not-found-85ee6409d3b4f81c.js\" async=\"\"></script><link rel=\"icon\" href=\"/favicon.ico\"/><title>Table d&#x27;Adrian - Luxury Private Chef Services | Personal Chef London</title><meta name=\"description\" content=\"Luxury private chef services by Table d&#x27;Adrian. Professional personal chef for private events, dinner parties, weekly meal prep. Michelin-trained chef serving London &amp; Europe.\"/><meta name=\"author\" content=\"Table d&#x27;Adrian\"/><meta name=\"keywords\" content=\"private chef, personal chef, luxury chef services, private chef london, private chef for events, private chef cost, hire private chef, bespoke culinary experiences, private chef meal planning, corporate chef services\"/><meta name=\"creator\" content=\"Table d&#x27;Adrian\"/><meta name=\"publisher\" content=\"Table d&#x27;Adrian\"/><meta name=\"robots\" content=\"index, follow\"/><link rel=\